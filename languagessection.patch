diff --git a/assets/css/styles.css b/assets/css/styles.css
index 1c5ab2a..ba71c23 100644
--- a/assets/css/styles.css
+++ b/assets/css/styles.css
@@ -708,6 +708,62 @@ a { color: inherit; text-decoration: none; }
 .lang-list li:last-child { border-bottom: 0; padding-bottom: 0; }
 .lang-level { color: var(--muted); font-size: .82rem; text-align: right; }
 
+/* Languages is the standout card: spans the grid, borrows the highlight-card
+   look (gradient surface + accent spine) so it outranks the plain chip cards. */
+.skill-card--feature {
+  position: relative;
+  overflow: hidden;
+  border-color: color-mix(in srgb, var(--accent) 22%, var(--line));
+  background:
+    linear-gradient(180deg,
+      color-mix(in srgb, var(--surface-2) 92%, transparent),
+      color-mix(in srgb, var(--surface) 92%, transparent));
+}
+.skill-card--feature::before {
+  content: '';
+  position: absolute;
+  inset: 0 auto 0 0;
+  width: 2px;
+  background: linear-gradient(180deg, var(--accent), var(--accent-soft));
+  opacity: .8;
+}
+.skill-card--feature:hover {
+  border-color: color-mix(in srgb, var(--accent) 60%, var(--line));
+  background:
+    linear-gradient(180deg,
+      color-mix(in srgb, var(--surface-2) 96%, transparent),
+      color-mix(in srgb, var(--surface) 96%, transparent));
+  box-shadow: 0 12px 28px -14px color-mix(in srgb, var(--accent) 80%, transparent);
+}
+.skill-card--feature h3 { font-size: clamp(1.35rem, 2.4vw, 1.6rem); }
+
+@media (min-width: 640px) {
+  .skill-card--feature { grid-column: 1 / -1; }
+  .skill-card--feature .lang-list {
+    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
+    gap: 1.25rem;
+  }
+  .skill-card--feature .lang-list li {
+    flex-direction: column;
+    align-items: flex-start;
+    gap: .4rem;
+    border-bottom: 0;
+    padding-bottom: 0;
+  }
+}
+
+.skill-card--feature .lang-name { color: var(--text); font-weight: 600; }
+.skill-card--feature .lang-level { text-align: left; }
+
+.lang-meter { display: flex; gap: 3px; max-width: 150px; }
+.lang-step {
+  width: 20px;
+  height: 4px;
+  border-radius: 2px;
+  background: color-mix(in srgb, var(--text) 12%, transparent);
+}
+.lang-step.is-on { background: var(--accent); }
+
 /* ── Timeline ───────────────────────────────────────────────────────────── */
 
 .timeline {
@@ -1020,7 +1076,7 @@ a.project-link:hover { text-decoration: underline; text-underline-offset: 4px; }
 /* ── Print ──────────────────────────────────────────────────────────────── */
 
 @media print {
-  .site-header, .hl-controls, .hero-glow, .skip-link { display: none !important; }
+  .site-header, .hl-controls, .hero-glow, .skip-link, .lang-meter { display: none !important; }
   body { background: #fff; color: #000; }
   .js .hl-card { grid-area: auto; opacity: 1; visibility: visible; transform: none; }
 }
